generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MEMBER
}

enum Depth {
  RAPIDA
  PADRAO
  DETALHADA
}

enum Severity {
  BAIXA
  MEDIA
  ALTA
}

enum FindingSource {
  STATIC_ANALYSIS
  AI
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  name         String
  passwordHash String
  memberships  TeamMember[]
  createdAt    DateTime     @default(now())
}

model Team {
  id        String       @id @default(uuid())
  name      String
  members   TeamMember[]
  projects  Project[]
  createdAt DateTime     @default(now())
}

model TeamMember {
  id     String @id @default(uuid())
  userId String
  teamId String
  role   Role   @default(MEMBER)
  user   User   @relation(fields: [userId], references: [id])
  team   Team   @relation(fields: [teamId], references: [id])

  @@unique([userId, teamId])
}

model Project {
  id                 String        @id @default(uuid())
  teamId             String
  name               String
  description        String?
  objective          String?
  technologies       String[]
  supportedLanguages String[]
  architecture       String?
  conventions        String?
  additionalInfo     String?
  team               Team          @relation(fields: [teamId], references: [id])
  rules              Rule[]
  analyses           Analysis[]
  contextEntries     ContextEntry[]
  createdAt          DateTime      @default(now())
}

model ContextEntry {
  id              String    @id @default(uuid())
  projectId       String
  content         String
  sourceFindingId String?
  project         Project   @relation(fields: [projectId], references: [id])
  sourceFinding   Finding?  @relation(fields: [sourceFindingId], references: [id])
  createdAt       DateTime  @default(now())
}

model Rule {
  id         String        @id @default(uuid())
  projectId  String
  identifier String
  project    Project       @relation(fields: [projectId], references: [id])
  versions   RuleVersion[]
  createdAt  DateTime      @default(now())
}

model RuleVersion {
  id                   String                @id @default(uuid())
  ruleId               String
  version              Int
  title                String
  description          String
  scope                String?
  rule                 Rule                  @relation(fields: [ruleId], references: [id])
  analysesUsedIn       AnalysisRuleVersion[]
  createdAt            DateTime              @default(now())

  @@unique([ruleId, version])
}

model Analysis {
  id               String                @id @default(uuid())
  projectId        String
  code             String
  language         String
  depth            Depth
  categories       String[]
  project          Project               @relation(fields: [projectId], references: [id])
  findings         Finding[]
  ruleVersionsUsed AnalysisRuleVersion[]
  createdAt        DateTime              @default(now())
}

model AnalysisRuleVersion {
  id            String      @id @default(uuid())
  analysisId    String
  ruleVersionId String
  analysis      Analysis    @relation(fields: [analysisId], references: [id])
  ruleVersion   RuleVersion @relation(fields: [ruleVersionId], references: [id])
}

model Finding {
  id             String          @id @default(uuid())
  analysisId     String
  category       String
  classification String
  location       String
  description    String
  evidence       String
  severity       Severity
  confidence     Int
  suggestion     String?
  source         FindingSource
  metadata       Json?
  isBlocking     Boolean         @default(false)
  analysis       Analysis        @relation(fields: [analysisId], references: [id])
  clarifications Clarification[]
  contextEntries ContextEntry[]
}

model Clarification {
  id               String    @id @default(uuid())
  findingId        String
  question         String
  answer           String?
  appliedToContext Boolean   @default(false)
  finding          Finding   @relation(fields: [findingId], references: [id])
  answeredAt       DateTime?
  createdAt        DateTime  @default(now())
}
